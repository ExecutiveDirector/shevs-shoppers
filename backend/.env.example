# Server
PORT=4000
NODE_ENV=production

# Allowed origin(s), comma-separated, no trailing slash. CORS only checks
# scheme+host, not the path — so one GitHub Pages origin covers both the
# storefront at "/" and the admin panel at "/admin/".
CORS_ORIGIN=https://your-username.github.io,http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shevs_app
DB_PASSWORD=change-me
DB_NAME=shevs
DB_CONNECTION_LIMIT=10

# Shop settings
FREE_DELIVERY_THRESHOLD=3000
DEFAULT_DELIVERY_FEE=250
# Digits only — country code + number, no +, no spaces, no placeholder letters
# (e.g. 254712345678). Anything non-numeric left in here gets silently
# stripped, which produces a broken wa.me link.
WHATSAPP_NUMBER=254712345678

# Admin access — a single shared key, sent as the x-admin-key header.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string

# Order alert emails (optional). Get a key at resend.com. MAIL_FROM must use a
# domain verified in Resend (the default only delivers to your own Resend login email).
# The owner's address itself is set in Admin → Settings → "Email me new orders at".
RESEND_API_KEY=
MAIL_FROM=Shevs Orders <orders@your-domain.com>
# Link shown in the alert email (your admin panel URL)
ADMIN_URL=https://your-shop.vercel.app/admin/
# Secret used to sign customer login tokens. Set a long random value in production.
# If unset it is derived from ADMIN_API_KEY (changing the admin key then logs customers out).
ACCOUNT_SECRET=
# Optional: lets the admin match photos to products by what is in them (Claude vision). Leave empty to switch off.
ANTHROPIC_API_KEY=
# "Continue with Google": OAuth Web client ID from Google Cloud Console (APIs & Services > Credentials).
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
# Optional: public URL of this API if uploads must be addressed differently than the request host
PUBLIC_API_URL=

# Public address of the storefront (no trailing slash). Used for the "Track your order"
# link in customer emails and the product link in back-in-stock emails.
STOREFRONT_URL=https://shevs-shoppers.vercel.app

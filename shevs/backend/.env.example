# Server
PORT=4000
NODE_ENV=production

# Allowed origin(s), comma-separated, no trailing slash. CORS only checks
# scheme+host, not the path — so one GitHub Pages origin covers both the
# storefront at "/" and the admin panel at "/admin/".
CORS_ORIGIN=https://your-username.github.io,http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shevs_app
DB_PASSWORD=change-me
DB_NAME=shevs
DB_CONNECTION_LIMIT=10

# Shop settings
FREE_DELIVERY_THRESHOLD=3000
DEFAULT_DELIVERY_FEE=250
# Digits only — country code + number, no +, no spaces, no placeholder letters
# (e.g. 254712345678). Anything non-numeric left in here gets silently
# stripped, which produces a broken wa.me link.
WHATSAPP_NUMBER=254712345678

# Admin access — a single shared key, sent as the x-admin-key header.
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=change-me-to-a-long-random-string
